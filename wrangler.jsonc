{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "supertwitter-client",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "x.swyx.io", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "HIGH_SIGNAL", "class_name": "HighSignalFeed" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HighSignalFeed"] }],
}
