{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "supertwitter-client",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "x.swyx.io", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
