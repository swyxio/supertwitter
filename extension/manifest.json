{
  "manifest_version": 3,
  "name": "SuperTwitter local connector",
  "version": "1.0.0",
  "description": "Connect your X accounts to SuperTwitter on this device.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://api.x.com/*"],
  "background": {"service_worker": "worker.mjs", "type": "module"},
  "options_page": "options.html",
  "action": {"default_title": "Manage connected X accounts"},
  "content_scripts": [{
    "matches": ["https://x.swyx.io/*", "http://localhost/*", "http://127.0.0.1/*"],
    "include_globs": ["https://x.swyx.io/*", "http://localhost:5173/*", "http://127.0.0.1:5173/*"],
    "run_at": "document_start",
    "js": ["bridge.js"]
  }],
  "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; img-src 'self' data:; connect-src https://api.x.com; base-uri 'none'; frame-ancestors 'none'"}
}
